
from datetime import datetime, timezone

from pyspark.sql import functions as F

from src.config import BRONZE_PATH


def load_bronze(df):

    print("Starting Bronze layer processing...")

    # Generate ingestion batch ID
    batch_id = datetime.now(
        timezone.utc
    ).strftime("%Y%m%d%H%M%S%f")

    # Add ingestion timestamp
    bronze_df = (
        df
        .withColumn(
            "ingestion_timestamp",
            F.current_timestamp()
        )
        .withColumn(
            "batch_id",
            F.lit(batch_id)
        )
    )

    # Write raw data into Delta format
    (
        bronze_df.write
        .format("delta")
        .mode("append")
        .save(str(BRONZE_PATH))
    )

    print("Bronze layer completed")

    print("Bronze records:", bronze_df.count())

    return bronze_df
